
<Application x:Class="FPSMonitor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0B0F"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#15151D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#39FF14"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
    </Application.Resources>
</Application>
