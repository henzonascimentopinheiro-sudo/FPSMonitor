
<Window x:Class="FPSMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS Monitor"
        Height="560"
        Width="900"
        MinHeight="500"
        MinWidth="750"
        Background="#0B0B0F"
        Foreground="White"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,28">
            <TextBlock Text="FPS MONITOR"
                       FontSize="30"
                       FontWeight="Bold"
                       Foreground="#39FF14"/>
            <TextBlock Text="MONITOR DE DESEMPENHO DO PC"
                       FontSize="11"
                       Foreground="#888888"
                       Margin="2,5,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#15151D"
                    BorderBrush="#39FF14" BorderThickness="1"
                    Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="FPS" Foreground="#AAAAAA"/>
                    <TextBlock x:Name="FpsText"
                               Text="--"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="#39FF14"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#15151D"
                    BorderBrush="#33333D" BorderThickness="1"
                    Padding="16" Margin="4,0">
                <StackPanel>
                    <TextBlock Text="CPU" Foreground="#AAAAAA"/>
                    <TextBlock x:Name="CpuText"
                               Text="--%"
                               FontSize="32"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#15151D"
                    BorderBrush="#33333D" BorderThickness="1"
                    Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="MEMÓRIA RAM"
                               Foreground="#AAAAAA"/>
                    <TextBlock x:Name="RamText"
                               Text="--%"
                               FontSize="32"
                               FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="#15151D"
                BorderBrush="#33333D"
                BorderThickness="1"
                Padding="20">
            <StackPanel>
                <TextBlock Text="DESEMPENHO DO SISTEMA"
                           FontSize="16"
                           FontWeight="Bold"/>
                <TextBlock Text="Os dados reais serão conectados na próxima etapa."
                           Foreground="#888888"
                           Margin="0,12,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="FPS MONITOR  |  EM DESENVOLVIMENTO"
                   Foreground="#666666"
                   FontSize="10"
                   Margin="0,16,0,0"
                   HorizontalAlignment="Right"/>
    </Grid>
</Window>
