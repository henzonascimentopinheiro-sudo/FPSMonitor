
<Window x:Class="FPSMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS Monitor"
        Width="175"
        Height="95"
        MinWidth="175"
        MinHeight="95"
        MaxWidth="175"
        MaxHeight="95"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Border Background="#EE050505"
            BorderBrush="#39FF14"
            BorderThickness="1.5"
            Padding="7">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="18"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <TextBlock Text="FPS MONITOR"
                           Foreground="#39FF14"
                           FontSize="10"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <Button Content="X"
                        Width="18"
                        Height="16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#171717"
                        Foreground="#39FF14"
                        BorderBrush="#39FF14"
                        BorderThickness="1"
                        FontSize="9"
                        Padding="0"
                        Click="FecharOverlay_Click"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,3,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            VerticalAlignment="Center">
                    <TextBlock Text="FPS"
                               Foreground="#AAAAAA"
                               FontSize="9"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="FpsText"
                               Text="--"
                               Foreground="#39FF14"
                               FontSize="19"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock Text="CPU"
                               Foreground="#AAAAAA"
                               FontSize="9"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="CpuText"
                               Text="--%"
                               Foreground="White"
                               FontSize="13"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            VerticalAlignment="Center">
                    <TextBlock Text="RAM"
                               Foreground="#AAAAAA"
                               FontSize="9"
                               HorizontalAlignment="Center"/>

                    <TextBlock x:Name="RamText"
                               Text="-- MB"
                               Foreground="White"
                               FontSize="10"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
