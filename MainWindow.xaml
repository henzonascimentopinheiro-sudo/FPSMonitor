
<Window x:Class="FPSMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FPS Monitor"
        Width="255"
        Height="145"
        MinWidth="255"
        MinHeight="145"
        MaxWidth="255"
        MaxHeight="145"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        Left="1000"
        Top="12">

    <Border Background="#F00B0B0F"
            BorderBrush="#39FF14"
            BorderThickness="1"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="FPS MONITOR"
                       FontSize="12"
                       FontWeight="Bold"
                       Foreground="#39FF14"
                       VerticalAlignment="Center"/>

            <Button Grid.Row="0"
                    Grid.Column="1"
                    Content="X"
                    Width="22"
                    Height="20"
                    Foreground="White"
                    Background="#22222A"
                    BorderBrush="#39FF14"
                    Click="FecharOverlay_Click"/>

            <StackPanel Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,8,0,0">

                <StackPanel Width="90">
                    <TextBlock Text="FPS"
                               FontSize="10"
                               Foreground="#AAAAAA"/>

                    <TextBlock x:Name="FpsText"
                               Text="--"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#39FF14"/>
                </StackPanel>

                <StackPanel Margin="5,5,0,0">
                    <TextBlock Text="CPU"
                               FontSize="10"
                               Foreground="#AAAAAA"/>

                    <TextBlock x:Name="CpuText"
                               Text="--%"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="RAM do monitor"
                               FontSize="10"
                               Foreground="#AAAAAA"
                               Margin="0,4,0,0"/>

                    <TextBlock x:Name="RamText"
                               Text="-- MB"
                               FontSize="12"
                               Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
